{
  "name": "citeapply",
  "version": "0.1.0",
  "private": true,
  "description": "A fictional, synthetic-only WebMCP education-aid application demo.",
  "type": "module",
  "engines": {
    "node": "24.20.0",
    "npm": "11.19.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "generate:fixtures": "node scripts/generate-fixtures.mjs",
    "verify:fixture-hashes": "node scripts/generate-fixtures.mjs --check",
    "verify:versions": "node --input-type=module -e \"if(process.version!=='v24.20.0'||!process.env.npm_config_user_agent?.startsWith('npm/11.19.0 ')){throw new Error('Expected Node 24.20.0 and npm 11.19.0')} console.log(process.version, process.env.npm_config_user_agent.split(' ')[0])\"",
    "verify:dependencies": "node --input-type=module -e \"const p=JSON.parse(await (await import('node:fs/promises')).readFile('package.json','utf8'));const direct={...p.dependencies,...p.devDependencies};for(const [name,version] of Object.entries(direct)){if(!/^\\d+\\.\\d+\\.\\d+$/.test(version))throw new Error(name+' must use an exact version: '+version)}console.log(Object.keys(direct).length+' exact direct dependency pins')\"",
    "verify:production-imports": "node scripts/verify-production-imports.mjs",
    "verify:built-anti-hardcode": "node scripts/verify-built-anti-hardcode.mjs",
    "verify:surfaces": "node scripts/verify-file-structure.mjs --surfaces",
    "test:contracts": "sh -c 'node --env-file-if-exists=.env.local --test tests/contract/*.test.ts' --",
    "test:unit": "sh -c 'node --env-file-if-exists=.env.local --test tests/unit/*.test.ts' --",
    "test:integration": "sh -c 'node --env-file-if-exists=.env.local --test tests/integration/*.test.ts' --",
    "test:security": "sh -c 'node --env-file-if-exists=.env.local --test tests/security/*.test.ts' --",
    "test:a11y": "playwright test tests/accessibility",
    "test:e2e": "playwright test tests/e2e",
    "test:all": "sh -c 'node --env-file-if-exists=.env.local --test tests/contract/*.test.ts tests/security/*.test.ts tests/unit/*.test.ts tests/integration/*.test.ts' --"
  },
  "dependencies": {
    "next": "15.5.24",
    "pdfjs-dist": "6.2.108",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.2",
    "eslint-config-next": "15.5.23",
    "fast-check": "4.9.0",
    "pdf-lib": "1.17.1",
    "typescript": "6.0.3",
    "webmcp-types": "0.1.5"
  }
}
